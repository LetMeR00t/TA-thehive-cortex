
# Application-level permissions

[]
owner = admin
access = read : [ * ], write : [ admin, sc_admin ]
export = system

# In Splunk Cloud the administrator role is sc_admin, not admin: a knowledge
# object writable by admin alone is unreachable for a Cloud customer.
[views]
access = read : [ * ], write : [ admin, sc_admin ]

[nav]
access = read : [ * ], write : [ admin, sc_admin ]

# Watermarks of the live inputs: written by the inputs only, never shared outside the add-on.
[collections/thehive_cortex_checkpoints]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = none
