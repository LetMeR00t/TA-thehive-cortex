<form version="1.1">
  <label>Analyzers</label>
  <init>
    <set token="last_refresh">now()</set>
  </init>
  <fieldset submitButton="false">
    <input type="dropdown" token="action">
      <label>Action</label>
      <choice value="refresh">REFRESH</choice>
      <choice value="list">LIST</choice>
      <default>list</default>
      <initialValue>list</initialValue>
      <change>
        <condition value="list">
          <unset token="run_refresh"></unset>
        </condition>
        <condition value="refresh">
          <set token="run_refresh">1</set>
          <set token="status">Waiting for input</set>
          <set token="status_color">red</set>
        </condition>
      </change>
    </input>
    <input type="dropdown" token="instance_id" searchWhenChanged="true">
      <label>Instance</label>
      <fieldForLabel>instance_name</fieldForLabel>
      <fieldForValue>id</fieldForValue>
      <search>
        <query>| rest /servicesNS/nobody/TA-thehive-cortex/thehive_cortex_instances splunk_server=local
| rename title as id
| where type="Cortex3"
| eval instance_name = id+" ("+environment+")"</query>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
        <done>
          <condition match="$job.resultCount$ &gt; 0">
            <set token="form.instance_id">$result.id$</set>
          </condition>
        </done>
      </search>
    </input>
    <!-- The Debug radio used to gate the refresh panel, which is why choosing
         REFRESH alone did nothing. Now that the panel is gated on the action
         that asks for it, this control drove nothing at all: a switch a user
         can flip with no visible effect is worse than no switch. -->
  </fieldset>
  <row>
    <panel>
      <title>Analyzers found for instance "$instance_id$"</title>
      <table>
        <search>
          <query>| inputlookup cortex_analyzers where instance_id=$instance_id$
| eval updated = $last_refresh$
| makemv delim=";" dataTypeList
| table name, dataTypeList, description
| rename name as Name, dataTypeList as "Data Type allowed", description as Description</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
          <sampleRatio>1</sampleRatio>
        </search>
        <option name="count">20</option>
        <option name="dataOverlayMode">none</option>
        <option name="drilldown">none</option>
        <option name="percentagesRow">false</option>
        <option name="refresh.display">progressbar</option>
        <option name="rowNumbers">false</option>
        <option name="totalsRow">false</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>
  <row>
    <panel depends="$run_refresh$">
      <!-- Native `single`, deliberately. The panel only confirms that the
           refresh ran; the previous version used the third-party visualization
           `status_indicator_app.status_indicator`, which was NOT declared as a
           dependency anywhere. Two ways that went wrong: an add-on that does
           not have it renders an empty box with no explanation, and AppInspect
           flags an undeclared dependency. Forcing every user to install a
           third-party app for a confirmation banner is out of proportion, and
           dropping the panel would lose the feedback, which only became
           meaningful once cortexrefreshanalyzers was repaired and could
           actually run. -->
      <single>
        <search>
          <query>| makeresults
| eval time = strftime(now(),"%T"), status = "Analyzers refresh - $status$ at "+time
| table status</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
          <sampleRatio>1</sampleRatio>
        </search>
        <option name="drilldown">none</option>
        <option name="height">53</option>
        <option name="refresh.display">progressbar</option>
        <option name="colorMode">block</option>
        <option name="rangeColors">["$status_color$","$status_color$"]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
  </row>
  <row>
    <!-- This is the ONLY panel that runs cortexrefreshanalyzers and writes the
         lookup, and it used to be gated on show_debug. Choosing Action =
         REFRESH therefore set the status banner to a red "Waiting for input"
         and did nothing else: the refresh only ran for whoever also switched
         Debug to Yes. The gate now matches the action that asks for it.

         The old sub-title claimed the search "is used to add a new instance",
         which it never did. It rewrites the analyzer lookup. -->
    <panel depends="$run_refresh$">
      <title>Refresh analyzers for the given instance "$instance_id$"</title>
      <table>
        <title>Queries Cortex for its analyzer list and rewrites the lookup</title>
        <search>
          <progress>
            <set token="status">Ongoing</set>
            <set token="status_color">orange</set>
          </progress>
          <done>
            <eval token="last_refresh">now()</eval>
            <set token="status">Done</set>
            <set token="status_color">green</set>
          </done>
          <query>| inputlookup cortex_analyzers
| where instance_id!="$instance_id$"
| append [
    | makeresults
    | cortexrefreshanalyzers $instance_id$
    | eval cortex_analyzer_dataTypeList = mvjoin(cortex_analyzer_dataTypeList,";"), enable = $run_refresh$
    | table cortex_analyzer_name, cortex_analyzer_description, cortex_analyzer_dataTypeList
    | rename cortex_analyzer_* as *
    | eval instance_id = "$instance_id$"]
| outputlookup cortex_analyzers</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
          <sampleRatio>1</sampleRatio>
        </search>
        <option name="count">20</option>
        <option name="dataOverlayMode">none</option>
        <option name="drilldown">none</option>
        <option name="percentagesRow">false</option>
        <option name="refresh.display">progressbar</option>
        <option name="rowNumbers">false</option>
        <option name="totalsRow">false</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>
</form>
